# Copy this file to `.env.local` and adjust.
# Never put Gnani API keys here. Keys live only in backend/.env.

# true  = use built-in mock data (no backend needed)
# false = call the real Kavach FastAPI backend
VITE_USE_MOCK=true

# Base path for REST calls. "/api" goes through the Vite dev proxy.
VITE_API_BASE_URL=/api

# Optional full WebSocket URL. Leave empty to use the dev proxy (/ws/transcribe).
VITE_WS_URL=

# Where the Vite dev proxy forwards /api and /ws (used by vite.config.ts only).
KAVACH_BACKEND_URL=http://127.0.0.1:8000
